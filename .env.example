# Copy to .env and adjust. Never commit the real .env file.

# --- Frontend -> API ---------------------------------------------------------
# Inside Docker Compose the API is reachable by service name.
# Locally, use http://127.0.0.1:8000
API_URL=http://api:8000

# --- MLflow ------------------------------------------------------------------
# Tracking server used by src/air_quality/train.py.
# Locally, use http://localhost:5000
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=riyadh-air-quality

# --- Dokploy -----------------------------------------------------------------
# Domains assigned to each service in the Dokploy dashboard.
# Set these in the Dokploy UI, not in a committed file.
# FRONTEND_DOMAIN=air-quality.example.com
# API_DOMAIN=api.air-quality.example.com
